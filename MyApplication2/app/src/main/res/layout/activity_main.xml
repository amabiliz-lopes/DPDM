<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Monitor de Localização"
        android:textColor="#1F2937"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#E0F2FE"
        android:padding="12dp"
        android:text="Aguardando localização..."
        android:textColor="#0F172A"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textLatitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Latitude: --"
        android:textColor="#111827"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/textLongitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Longitude: --"
        android:textColor="#111827"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/textPrecisao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Precisão: --"
        android:textColor="#111827"
        android:textSize="20sp" />

    <Button
        android:id="@+id/buttonAtualizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Iniciar rastreio" />

    <Button
        android:id="@+id/buttonParar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Parar rastreio" />

</LinearLayout>